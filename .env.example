# Application runtime
APP_ENV=production
PILOT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-app-domain.example.com

# MySQL / MariaDB connection
PILOT_DB_HOST=127.0.0.1
PILOT_DB_PORT=3306
PILOT_DB_NAME=student_monitoring
PILOT_DB_USER=root
PILOT_DB_PASSWORD=

# Optional: override when your host sets a direct database URL
# DATABASE_URL=mysql://user:password@host:3306/database_name
